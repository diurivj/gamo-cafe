{
  "name": "gamo-cafe",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:production": "CLOUDFLARE_ENV=production react-router build",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm test",
    "db:migrate": "wrangler d1 migrations apply DB --config wrangler.jsonc --local",
    "db:migrate:production": "wrangler d1 migrations apply DB --config wrangler.jsonc --env production --remote",
    "projections:verify": "node scripts/projections.ts verify",
    "projections:verify:production": "node scripts/projections.ts verify --production",
    "projections:rebuild": "node scripts/projections.ts rebuild",
    "projections:rebuild:production": "node scripts/projections.ts rebuild --production",
    "seed": "node scripts/seed.ts",
    "seed:local": "node scripts/seed.ts --local",
    "deploy:production": "npm run build:production && wrangler deploy",
    "sign-in-code": "node scripts/sign-in-code.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@react-router/cloudflare": "^8.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "effect": "~4.0.1",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
