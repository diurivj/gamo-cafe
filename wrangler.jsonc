{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level is the local environment; `env.production` is the only other one.
  "name": "gamo-cafe-local",
  "compatibility_date": "2026-10-01",
  "main": "./workers/app.ts",
  "vars": {
    "APP_ENV": "local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamo-cafe-db-local",
      // Never reaches Cloudflare: it only names the local SQLite file.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "env": {
    "production": {
      "name": "gamo-cafe",
      "workers_dev": true,
      // The owner's domain: Wrangler creates the DNS record and the
      // certificate, and the app is reached at this address too.
      "routes": [{ "pattern": "gamo-cafe.diurivj.com", "custom_domain": true }],
      // A ceiling against a runaway request, not a target: the plan bills CPU
      // time and has no spending cap (ADR 0007).
      "limits": { "cpu_ms": 1000 },
      "vars": {
        "APP_ENV": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gamo-cafe-db",
          "database_id": "489c5790-7285-4984-b735-89786843f70e",
          "migrations_dir": "./migrations"
        }
      ]
    }
  }
}
