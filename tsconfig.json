{
  "files": [],
  "references": [
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.cloudflare.json" }
  ],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    // A `switch` over typed errors that misses a case fails to compile.
    "noImplicitReturns": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
