{
  "files": [],
  "references": [
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.cloudflare.json" }
  ],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    // A `switch` over typed errors that misses a case fails to compile.
    "noImplicitReturns": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Also in tsconfig.cloudflare.json, which is what compiles the app; here
    // because the shadcn CLI reads the alias from this file.
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
